# Copy this file to config/.env and fill in values.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/jhola
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary (image uploads via POST /api/upload). Leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Security
# Demo OTP shows the code on screen and only works for NEW accounts. Default: on in development, off in production.
OTP_DEMO=
# Built-in test payment gateway (no real money). Set to false once real eSewa/Khalti verification is added.
TEST_PAYMENTS=true
# Set to 1 when running behind one reverse proxy (nginx, Render, Railway) so rate limits see real client IPs.
TRUST_PROXY=
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_SIGNUPS_PER_HOUR=10
