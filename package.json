{
  "name": "jhola",
  "version": "1.0.0",
  "description": "Jhola — Apni Marzi, Apni Shopping. MERN e-commerce store.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "server": "node --watch-path=server --watch-path=config server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c blue,yellow \"npm run server\" \"npm run client\"",
    "seed": "node server/data/seed.js",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "npm install && npm --prefix client install && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
